@page
@model Soporte.Web.Pages.Admin.Configuracion.SlaModel
@{
    ViewData["Title"] = "Configuración de SLA";
}

<header class="encabezado-pagina">
    <div>
        <h1>Configuración de SLA</h1>
        <p>Define el tiempo máximo de atención por prioridad</p>
    </div>
</header>

@if (TempData["MensajeExito"] is string exito)
{
    <div class="alerta-exito" role="status" data-autocerrar>@exito</div>
}
@if (TempData["MensajeError"] is string err)
{
    <div class="alerta-error" role="alert">@err</div>
}

<div style="max-width:640px;display:flex;flex-direction:column;gap:14px">

    <div class="tarjeta">
        <div class="tarjeta-seccion" style="border-bottom:1px solid var(--color-borde);padding-bottom:14px">
            <div style="display:flex;gap:10px;align-items:flex-start">
                <span style="font-size:18px;line-height:1;margin-top:1px">⏱</span>
                <p style="margin:0;font-size:13px;color:var(--color-texto-secundario);line-height:1.6">
                    El SLA define cuántas horas tiene el equipo para atender un ticket antes de que aparezca como
                    <strong style="color:var(--rojo)">SLA vencido</strong>.
                    Los cambios aplican de inmediato a tickets nuevos y activos.
                </p>
            </div>
        </div>

        <table class="tabla-sla">
            <thead>
                <tr>
                    <th>Prioridad</th>
                    <th>Configuración actual</th>
                    <th>Actualizar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Prioridades)
                {
                    <tr>
                        <td>
                            <span class="pill @SlaModel.ClasePrioridad(p.Id)">@p.Nombre</span>
                        </td>
                        <td>
                            <span class="sla-horas-actual">@p.HorasSla h</span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Actualizar" class="fila-sla-form">
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="number" name="horasSla" value="@p.HorasSla"
                                       min="1" max="720" class="campo campo-compacto sla-input"
                                       aria-label="Horas SLA para @p.Nombre" />
                                <span class="sla-unidad">h</span>
                                <button type="submit" class="boton-secundario boton-compacto">Guardar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p style="font-size:12px;color:var(--color-texto-tenue);margin:0">
        Rango permitido: 1 – 720 horas por prioridad.
    </p>
</div>
