@page
@model Soporte.Web.Pages.Admin.Plantillas.PlantillasModel
@{
    ViewData["Title"] = "Plantillas de respuesta";
}

<header class="encabezado-pagina">
    <div>
        <h1>Plantillas de respuesta</h1>
        <p>Textos rápidos predefinidos para los agentes de soporte</p>
    </div>
    <button type="button" class="boton-primario" data-abrir-form-plantilla>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Nueva plantilla
    </button>
</header>

@if (TempData["MensajeExito"] is string exito)
{
    <div class="alerta-exito" role="status" data-autocerrar>@exito</div>
}
@if (TempData["MensajeError"] is string err)
{
    <div class="alerta-error" role="alert">@err</div>
}

<!-- Formulario de creación (oculto por defecto) -->
<div id="form-plantilla" style="display:none;max-width:580px;margin-bottom:20px">
    <div class="tarjeta">
        <div class="tarjeta-seccion">
            <p class="tarjeta-titulo">Nueva plantilla</p>
            <form method="post" asp-page-handler="Crear" data-envio-unico>
                <div class="grupo-campo">
                    <label class="etiqueta" for="nueva-titulo">Título</label>
                    <input type="text" id="nueva-titulo" name="Dto.Titulo" class="campo campo-completo"
                           maxlength="100" required placeholder="Ej. Cierre por inactividad" />
                </div>
                <div class="grupo-campo">
                    <label class="etiqueta" for="nueva-texto">Texto</label>
                    <textarea id="nueva-texto" name="Dto.Texto" class="campo campo-completo"
                              rows="4" maxlength="4000" required
                              placeholder="Escribí el mensaje completo…"></textarea>
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end">
                    <button type="button" class="boton-secundario" data-cerrar-form-plantilla>Cancelar</button>
                    <button type="submit" class="boton-primario">Guardar plantilla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!Model.Plantillas.Any())
{
    <div class="estado-vacio">
        <p>No hay plantillas todavía. Creá la primera con el botón de arriba.</p>
    </div>
}
else
{
    <div class="tarjeta">
        <table class="tabla">
            <thead>
                <tr>
                    <th style="width:220px">Título</th>
                    <th>Vista previa</th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Plantillas)
                {
                    <tr>
                        <td><strong>@p.Titulo</strong></td>
                        <td class="celda-secundaria">@(p.Texto.Length > 90 ? p.Texto[..90] + "…" : p.Texto)</td>
                        <td>
                            <div style="display:flex;gap:6px;justify-content:flex-end">
                                <button type="button" class="boton-secundario boton-xs"
                                        data-editar-plantilla
                                        data-id="@p.Id"
                                        data-titulo="@p.Titulo"
                                        data-texto="@p.Texto">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" style="display:inline" data-envio-unico>
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="boton-peligro boton-xs"
                                            onclick="return confirm('¿Desactivar «@p.Titulo»?')">Desactivar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal de edición -->
<dialog id="modal-editar-plantilla" class="app-dialog" aria-labelledby="titulo-modal-plantilla">
    <div class="modal-cabecera">
        <h2 class="modal-titulo" id="titulo-modal-plantilla">Editar plantilla</h2>
        <button type="button" class="modal-cerrar" data-cerrar-modal aria-label="Cerrar">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
    </div>
    <div class="modal-cuerpo" style="padding:0 22px 22px">
        <form method="post" asp-page-handler="Actualizar" data-envio-unico>
            <input type="hidden" name="id" id="edit-plantilla-id" />
            <div class="grupo-campo">
                <label class="etiqueta" for="edit-titulo">Título</label>
                <input type="text" id="edit-titulo" name="Dto.Titulo" class="campo campo-completo" maxlength="100" required />
            </div>
            <div class="grupo-campo">
                <label class="etiqueta" for="edit-texto">Texto</label>
                <textarea id="edit-texto" name="Dto.Texto" class="campo campo-completo" rows="5" maxlength="4000" required></textarea>
            </div>
            <div class="modal-acciones">
                <button type="button" class="boton-secundario" data-cerrar-modal>Cancelar</button>
                <button type="submit" class="boton-primario">Guardar cambios</button>
            </div>
        </form>
    </div>
</dialog>

@section Scripts {
<script>
(function () {
    var formWrap = document.getElementById('form-plantilla');
    document.querySelector('[data-abrir-form-plantilla]')?.addEventListener('click', function () {
        formWrap.style.display = '';
        formWrap.querySelector('input[type="text"]')?.focus();
    });
    document.querySelector('[data-cerrar-form-plantilla]')?.addEventListener('click', function () {
        formWrap.style.display = 'none';
    });

    var modal = document.getElementById('modal-editar-plantilla');
    document.querySelectorAll('[data-editar-plantilla]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('edit-plantilla-id').value = btn.dataset.id;
            document.getElementById('edit-titulo').value        = btn.dataset.titulo;
            document.getElementById('edit-texto').value         = btn.dataset.texto;
            modal.showModal();
        });
    });
    document.querySelectorAll('[data-cerrar-modal]').forEach(function (btn) {
        btn.addEventListener('click', function () { modal.close(); });
    });
    modal?.addEventListener('click', function (e) {
        if (e.target === modal) modal.close();
    });
})();
</script>
}
