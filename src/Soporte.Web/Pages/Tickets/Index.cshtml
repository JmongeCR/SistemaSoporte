@page
@model Soporte.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = Model.Titulo;
}

<header class="encabezado-pagina">
    <div>
        <h1>@Model.Titulo</h1>
        @if (Model.Tickets is not null)
        {
            <p>
                @Model.Tickets.Total @(Model.Tickets.Total == 1 ? "ticket" : "tickets")@(Model.HayFiltros ? " con estos filtros" : " en total")
                @if (Model.TotalAbiertos is not null)
                {
                    <text>· @Model.TotalAbiertos @(Model.TotalAbiertos == 1 ? "abierto" : "abiertos")</text>
                }
            </p>
        }
    </div>
    <button type="button" class="boton-primario" data-abrir-modal-crear>+ Nuevo Ticket</button>
</header>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alerta-exito" role="status" data-autocerrar>@mensajeExito</div>
}
@if (TempData["MensajeError"] is string mensajeErrorIndex)
{
    <div class="alerta-error" role="alert">@mensajeErrorIndex</div>
}

<form method="get" class="barra-filtros" role="search">
    <div class="buscador">
        <input asp-for="Filtro.Texto" class="campo" placeholder="Buscar ticket, cliente..." aria-label="Buscar por asunto o cliente" />
    </div>
    <select asp-for="Filtro.PrioridadId" asp-items="Model.Prioridades" class="campo" aria-label="Prioridad" onchange="this.form.requestSubmit()">
        <option value="">Prioridad</option>
    </select>
    <button type="submit" name="Filtro.EstadoId" value="" class="chip @(Model.Filtro.EstadoId is null ? "activo" : "")">Todos</button>
    @foreach (var estado in Model.Estados)
    {
        <button type="submit" name="Filtro.EstadoId" value="@estado.Id" class="chip @(Model.Filtro.EstadoId == estado.Id ? "activo" : "")">@estado.Nombre</button>
    }
</form>

@if (Model.MensajeError is not null)
{
    <div class="alerta-error" role="alert">@Model.MensajeError</div>
}
else if (Model.Tickets is not null)
{
    <div class="tarjeta">
        @if (Model.Tickets.Total == 0)
        {
            <div class="estado-vacio" role="status">No hay tickets que coincidan con los filtros.</div>
        }
        else
        {
            <table class="tabla tabla-tickets">
                <thead>
                    <tr>
                        <th class="col-id">ID</th>
                        <th class="col-titulo">Título</th>
                        @if (!Model.EsCliente) { <th class="col-cliente">Cliente</th> }
                        <th class="col-categoria">Categoría</th>
                        <th class="col-prioridad">Prioridad</th>
                        <th class="col-estado">Estado</th>
                        <th class="col-agente">Agente</th>
                        <th class="col-fecha">Creado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.Tickets.Elementos)
                    {
                        <tr class="fila-ticket" data-href="/Tickets/Detalle/@ticket.Id">
                            <td class="col-id">
                                <a asp-page="./Detalle" asp-route-id="@ticket.Id" class="chip-id">#@ticket.Id</a>
                            </td>
                            <td class="col-titulo">
                                <a asp-page="./Detalle" asp-route-id="@ticket.Id" class="enlace-titulo">@ticket.Asunto</a>
                                @if (ticket.EsperaRespuestaCliente)
                                {
                                    <span class="pill pill-alerta etiqueta-mini-fila">@(Model.EsCliente ? "Te esperan" : "Esperando cliente")</span>
                                }
                                @if (ticket.SlaVencido && !Model.EsCliente)
                                {
                                    <span class="pill pill-alerta etiqueta-mini-fila">SLA vencido</span>
                                }
                            </td>
                            @if (!Model.EsCliente)
                            {
                                <td class="col-cliente celda-secundaria">@ticket.Cliente</td>
                            }
                            <td class="col-categoria celda-secundaria">@ticket.Categoria</td>
                            <td class="col-prioridad">
                                <span class="prioridad-dot @Formato.ClasePrioridad(ticket.PrioridadId)" title="@ticket.Prioridad"></span>
                                <span class="celda-secundaria">@ticket.Prioridad</span>
                            </td>
                            <td class="col-estado">
                                <span class="pill @Formato.ClaseEstado(ticket.EstadoId)">@ticket.Estado</span>
                                @if (!Model.EsCliente)
                                {
                                    <button type="button" class="boton-estado-quick" aria-label="Cambiar estado"
                                            data-cambiar-estado
                                            data-ticket-id="@ticket.Id"
                                            data-asunto="@ticket.Asunto"
                                            data-estado-id="@ticket.EstadoId">✎</button>
                                }
                            </td>
                            <td class="col-agente">
                                @if (ticket.AgenteAsignado is null)
                                {
                                    <span class="celda-tenue">—</span>
                                }
                                else
                                {
                                    <span class="avatar avatar-sm" title="@ticket.AgenteAsignado">@Formato.Iniciales(ticket.AgenteAsignado)</span>
                                }
                            </td>
                            <td class="col-fecha celda-secundaria">@Formato.Hace(ticket.FechaCreacion)</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Tickets.TotalPaginas > 1)
            {
                <nav class="paginacion" aria-label="Paginación de tickets">
                    <span>Página @Model.Tickets.Pagina de @Model.Tickets.TotalPaginas</span>
                    <div class="paginacion-acciones">
                        <a class="chip @(Model.Tickets.Pagina <= 1 ? "deshabilitado" : "")" asp-page="./Index" asp-all-route-data="Model.RutaPagina(Model.Tickets.Pagina - 1)">Anterior</a>
                        <a class="chip @(Model.Tickets.Pagina >= Model.Tickets.TotalPaginas ? "deshabilitado" : "")" asp-page="./Index" asp-all-route-data="Model.RutaPagina(Model.Tickets.Pagina + 1)">Siguiente</a>
                    </div>
                </nav>
            }
        }
    </div>
}

@if (!Model.EsCliente)
{
    <dialog id="modal-cambiar-estado" class="dialogo" aria-labelledby="titulo-modal-estado">
        <form method="post" asp-page-handler="CambiarEstado" data-envio-unico>
            <header class="modal-encabezado">
                <h2 id="titulo-modal-estado">Cambiar estado</h2>
                <button type="button" class="modal-cerrar" data-cerrar-modal aria-label="Cerrar">✕</button>
            </header>
            <input type="hidden" name="ticketId" data-campo-estado="ticket-id" />
            <p class="modal-ticket-asunto" data-campo-estado="asunto"></p>
            <label class="etiqueta" for="nuevo-estado-sel">Nuevo estado</label>
            <select id="nuevo-estado-sel" name="nuevoEstadoId" class="campo campo-completo">
                @foreach (var estado in Model.Estados)
                {
                    <option value="@estado.Id">@estado.Nombre</option>
                }
            </select>
            <div class="modal-acciones">
                <button type="button" class="boton-secundario" data-cerrar-modal>Cancelar</button>
                <button type="submit" class="boton-primario">Guardar</button>
            </div>
        </form>
    </dialog>
}
