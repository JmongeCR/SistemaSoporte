@page "{id:int}"
@model Soporte.Web.Pages.Tickets.DetalleModel
@{
    ViewData["Title"] = Model.Ticket is null ? "Ticket" : $"#{Model.Ticket.Id} {Model.Ticket.Asunto}";
    var t = Model.Ticket;
}

<nav class="migas" aria-label="Ruta">
    <a asp-page="./Index">@(Model.EsCliente ? "Mis tickets" : "Tickets")</a>
    <span aria-hidden="true">/</span>
    <span class="migas-actual">#@Model.Id</span>
</nav>

@if (TempData["MensajeExito"] is string exito)
{
    <div class="alerta-exito" role="status">@exito</div>
}
@if (TempData["MensajeError"] is string errorTemporal)
{
    <div class="alerta-error" role="alert">@errorTemporal</div>
}
@if (Model.MensajeError is not null)
{
    <div class="alerta-error" role="alert">
        @Model.MensajeError
        @if (t is null) { <div><a asp-page="./Index" class="enlace">Volver a la lista</a></div> }
    </div>
}

@if (t is not null)
{
<div class="detalle">
    <div class="detalle-principal">
        <header class="detalle-encabezado">
            <h1>@t.Asunto</h1>
            @if (t.SlaVencido && Model.EsEquipo) { <span class="pill pill-alerta">SLA vencido</span> }
        </header>
        <p class="detalle-meta">
            <span class="ticket-id">#@t.Id</span> · Reportado por @t.Cliente · @Formato.Hace(t.FechaCreacion)
        </p>

        @if (t.EsperaRespuestaCliente)
        {
            <div class="aviso-info" role="status">
                @(Model.EsCliente ? "El equipo necesita información adicional para avanzar con tu caso. Respondé en la conversación." : "Se pidió información adicional al cliente y todavía no respondió.")
            </div>
        }

        <section class="tarjeta tarjeta-seccion">
            <h2 class="etiqueta-seccion"><span class="punto-azul" aria-hidden="true"></span>Descripción</h2>
            <p class="detalle-descripcion">@t.Descripcion</p>
            @if (t.Adjuntos.Count > 0)
            {
                <partial name="_AdjuntosTicket" model="(t.Adjuntos, t.Id)" />
            }
        </section>

        <h2 class="titulo-seccion" id="actividad">
            Actividad <span class="contador-gris">@Model.Actividad.Count</span>
        </h2>

        <ol class="actividad">
            @foreach (var item in Model.Actividad)
            {
                if (item.Evento is { } evento)
                {
                    <li class="evento">
                        <span class="evento-punto" aria-hidden="true"></span>
                        @if (evento.EstadoAnterior is null)
                        {
                            <span><strong>@evento.Usuario</strong> creó el ticket</span>
                        }
                        else
                        {
                            <span><strong>@evento.Usuario</strong> cambió el estado a <span class="pill @Formato.ClaseEstado(evento.EstadoNuevoId)">@evento.EstadoNuevo</span></span>
                        }
                        <time class="texto-tenue" datetime="@evento.FechaCambio.ToString("O")" title="@Model.FechaLocal(evento.FechaCambio)">@Formato.Hace(evento.FechaCambio)</time>
                    </li>
                }
                else if (item.Comentario is { } c)
                {
                    <li class="comentario @(c.EsNotaInterna ? "comentario-interno" : "") @(c.SolicitaInformacion ? "comentario-solicitud" : "")">
                        <span class="avatar avatar-grande @(c.RolAutor == "Cliente" ? "" : "avatar-equipo")">@Formato.Iniciales(c.Autor)</span>
                        <div class="comentario-cuerpo">
                            <div class="comentario-encabezado">
                                <strong>@c.Autor</strong>
                                <span class="etiqueta-mini">@c.RolAutor</span>
                                @if (c.EsNotaInterna) { <span class="etiqueta-mini etiqueta-interna">Nota interna · solo el equipo</span> }
                                @if (c.SolicitaInformacion) { <span class="etiqueta-mini etiqueta-solicitud">Solicitud de información</span> }
                                @if (!c.Leido) { <span class="etiqueta-mini etiqueta-nuevo">Nuevo</span> }
                                <time class="texto-tenue comentario-hora" datetime="@c.FechaCreacion.ToString("O")" title="@Model.FechaLocal(c.FechaCreacion)">@Formato.Hace(c.FechaCreacion)</time>
                            </div>
                            <p class="comentario-texto">@c.Texto</p>
                            @if (c.Adjuntos.Count > 0)
                            {
                                <partial name="_AdjuntosTicket" model="(c.Adjuntos, t.Id)" />
                            }
                        </div>
                    </li>
                }
            }
        </ol>

        @if (Model.PuedeResponder)
        {
            <form method="post" asp-page-handler="Comentar" asp-route-id="@t.Id" enctype="multipart/form-data" class="tarjeta caja-respuesta" data-envio-unico id="form-respuesta">
                @if (Model.EsEquipo)
                {
                    <div class="segmentado segmentado-compacto" role="radiogroup" aria-label="Tipo de mensaje">
                        @if (!Model.EstaCerrado)
                        {
                            <input type="radio" class="segmentado-opcion" id="tipo-publica" name="tipoRespuesta" value="publica" checked="@(Model.TipoRespuesta == "publica")" />
                            <label for="tipo-publica">Respuesta al cliente</label>
                            <input type="radio" class="segmentado-opcion" id="tipo-solicitud" name="tipoRespuesta" value="solicitud" checked="@(Model.TipoRespuesta == "solicitud")" />
                            <label for="tipo-solicitud">Solicitar información</label>
                        }
                        <input type="radio" class="segmentado-opcion" id="tipo-interna" name="tipoRespuesta" value="interna" checked="@(Model.TipoRespuesta == "interna" || Model.EstaCerrado)" />
                        <label for="tipo-interna">Nota interna</label>
                    </div>
                }
                @if (Model.EsEquipo)
                {
                    <div class="plantillas-selector" id="plantillas">
                        @if (Model.Plantillas.Any())
                        {
                            <select id="selector-plantilla" class="campo campo-compacto plantillas-select" aria-label="Insertar plantilla">
                                <option value="">📋 Insertar plantilla…</option>
                                @foreach (var p in Model.Plantillas)
                                {
                                    <option value="@p.Texto">@p.Titulo</option>
                                }
                            </select>
                        }
                        <button type="button" class="boton-secundario boton-compacto" id="btn-gestionar-plantillas">⚙ Plantillas</button>
                    </div>
                }
                <div class="caja-respuesta-fila">
                    <span class="avatar avatar-grande">@Formato.Iniciales(User.Identity?.Name)</span>
                    <div class="caja-respuesta-campos">
                        <label for="Respuesta_Texto" class="visually-hidden">Mensaje</label>
                        <textarea name="Respuesta.Texto" id="Respuesta_Texto" class="campo campo-completo" rows="3" maxlength="4000" required
                                  data-val="true" data-val-required="El comentario no puede estar vacío."
                                  placeholder="@(Model.EsCliente ? "Escribí tu respuesta o agregá información…" : "Escribe un comentario o actualización…")">@Model.Respuesta.Texto</textarea>
                        <span class="field-validation-valid" data-valmsg-for="Respuesta.Texto" data-valmsg-replace="true"></span>

                        <div class="zona-archivos zona-archivos-compacta" data-zona-archivos data-extensiones=".pdf,.png,.jpg,.jpeg" data-max-mb="10"
                             data-max-archivos="5" data-lista="#lista-adjuntos-respuesta" data-error="#error-adjuntos-respuesta">
                            <input type="file" name="adjuntos" multiple accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" aria-label="Adjuntar archivos" />
                            <p class="zona-archivos-ayuda">📎 Adjuntar PDF, PNG o JPG (máx. 10 MB)</p>
                        </div>
                        <p class="error-archivos" id="error-adjuntos-respuesta" role="alert"></p>
                        <ul class="lista-archivos" id="lista-adjuntos-respuesta"></ul>
                    </div>
                    <button type="submit" class="boton-primario">Enviar</button>
                </div>
            </form>
        }
        else
        {
            <div class="tarjeta estado-vacio">Este ticket está cerrado y no admite nuevas respuestas. Si el problema continúa, creá un ticket nuevo.</div>
        }
    </div>

    <aside class="detalle-lateral">
        <div class="tarjeta">
            <div class="dato-bloque dato-fechas">
                <span class="texto-secundario">Creado</span><strong>@Model.FechaLocal(t.FechaCreacion)</strong>
                <span class="texto-secundario">Actualizado</span><strong>@(t.FechaActualizacion is null ? "—" : Model.FechaLocal(t.FechaActualizacion.Value))</strong>
            </div>
        </div>

        <div class="tarjeta kb-lateral" id="kb">
            <h2 class="etiqueta-seccion"><span class="punto-azul" aria-hidden="true"></span>Artículos relacionados</h2>

            @if (Model.ArticulosVinculados.Any())
            {
                <ul class="kb-vinculados">
                    @foreach (var art in Model.ArticulosVinculados)
                    {
                        <li class="kb-vinculado-item">
                            <div class="kb-vinculado-info">
                                <a asp-page="/Ayuda/Articulo" asp-route-slug="@art.Slug" class="kb-vinculado-enlace" target="_blank">@art.Titulo</a>
                                <span class="kb-vinculado-cat">@art.CategoriaNombre</span>
                            </div>
                            @if (Model.PuedeGestionar)
                            {
                                <form method="post" asp-page-handler="DesvincularKb" asp-route-id="@t.Id">
                                    <input type="hidden" name="articuloId" value="@art.Id" />
                                    <button type="submit" class="btn-desvincular" title="Quitar artículo">×</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="kb-vacio">Sin artículos vinculados.</p>
            }

            @if (Model.PuedeGestionar && Model.ArticulosDisponibles.Any())
            {
                <form method="post" asp-page-handler="VincularKb" asp-route-id="@t.Id" class="kb-vincular-form">
                    <div class="kb-vincular-fila">
                        <select name="articuloId" class="campo kb-vincular-select">
                            <option value="">— Seleccionar —</option>
                            @foreach (var grp in Model.ArticulosDisponibles.GroupBy(a => a.CategoriaNombre).OrderBy(g => g.Key))
                            {
                                <optgroup label="@grp.Key">
                                    @foreach (var art in grp)
                                    {
                                        <option value="@art.Id">@art.Titulo</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <button type="submit" class="boton-secundario kb-vincular-btn">+</button>
                    </div>
                </form>
            }
        </div>

        @if (Model.PuedeCalificar)
        {
            <div class="tarjeta tarjeta-csat" id="csat">
                <h2 class="etiqueta-seccion">¿Cómo fue la atención?</h2>
                <form method="post" asp-page-handler="Calificar" asp-route-id="@t.Id" data-envio-unico>
                    <div class="estrellas-rating" role="group" aria-label="Calificación">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <input type="radio" id="star-@i" name="calificacion" value="@i" class="star-input" required />
                            <label for="star-@i" title="@i estrella@(i == 1 ? "" : "s")">★</label>
                        }
                    </div>
                    <textarea name="comentarioCsat" class="campo campo-completo csat-comentario" rows="2" maxlength="500"
                              placeholder="Comentario opcional…"></textarea>
                    <button type="submit" class="boton-primario boton-bloque">Enviar calificación</button>
                </form>
            </div>
        }
        else if (Model.Csat is not null && Model.EsEquipo)
        {
            <div class="tarjeta tarjeta-csat">
                <h2 class="etiqueta-seccion">Calificación del cliente</h2>
                <div class="csat-resultado">
                    <span class="csat-estrellas">@string.Concat(Enumerable.Repeat("★", Model.Csat.Calificacion))@string.Concat(Enumerable.Repeat("☆", 5 - Model.Csat.Calificacion))</span>
                    <span class="celda-secundaria">@Formato.Hace(Model.Csat.FechaCalificacion)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Csat.Comentario))
                {
                    <p class="csat-comentario-texto">@Model.Csat.Comentario</p>
                }
            </div>
        }

        @if (Model.PuedeTomar)
        {
            <form method="post" asp-page-handler="Tomar" asp-route-id="@t.Id" class="tarjeta tarjeta-accion" data-envio-unico>
                <p>Este ticket no tiene agente asignado.</p>
                <button type="submit" class="boton-primario boton-bloque">Asignarme ticket</button>
            </form>
        }

        @if (Model.PuedeReabrir)
        {
            <form method="post" asp-page-handler="Reabrir" asp-route-id="@t.Id" class="tarjeta tarjeta-accion" data-envio-unico>
                <input type="hidden" name="rowVersion" value="@t.RowVersion" />
                <p><strong>¿Sigue el problema?</strong> Podés reabrir el ticket.</p>
                <textarea name="motivo" class="campo campo-completo" rows="2" maxlength="4000" placeholder="Contanos qué sigue fallando (opcional)"></textarea>
                <button type="submit" class="boton-secundario boton-bloque">Reabrir ticket</button>
            </form>
        }

        @if (Model.PuedeGestionar)
        {
            <form method="post" asp-page-handler="Actualizar" asp-route-id="@t.Id" class="tarjeta tarjeta-accion" data-envio-unico>
                <h2 class="etiqueta-seccion">Gestionar ticket</h2>
                <input type="hidden" name="Cambios.RowVersion" value="@Model.Cambios.RowVersion" />
                <label class="etiqueta" for="Cambios_EstadoId">Estado</label>
                <select name="Cambios.EstadoId" id="Cambios_EstadoId" class="campo campo-completo" asp-items="@(new SelectList(Model.Estados, "Value", "Text", Model.Cambios.EstadoId))"></select>
                <label class="etiqueta" for="Cambios_PrioridadId">Prioridad</label>
                <select name="Cambios.PrioridadId" id="Cambios_PrioridadId" class="campo campo-completo" asp-items="@(new SelectList(Model.Prioridades, "Value", "Text", Model.Cambios.PrioridadId))"></select>
                <label class="etiqueta" for="Cambios_CategoriaId">Categoría</label>
                <select name="Cambios.CategoriaId" id="Cambios_CategoriaId" class="campo campo-completo" asp-items="@(new SelectList(Model.Categorias, "Value", "Text", Model.Cambios.CategoriaId))"></select>
                @if (Model.EsAdministrador)
                {
                    <label class="etiqueta" for="Cambios_AgenteAsignadoId">Agente asignado</label>
                    <select name="Cambios.AgenteAsignadoId" id="Cambios_AgenteAsignadoId" class="campo campo-completo" asp-items="@(new SelectList(Model.Agentes, "Value", "Text", Model.Cambios.AgenteAsignadoId))">
                        <option value="">Sin asignar</option>
                    </select>
                }
                else
                {
                    <input type="hidden" name="Cambios.AgenteAsignadoId" value="@Model.Cambios.AgenteAsignadoId" />
                }
                <label class="etiqueta" for="Cambios_MensajePublico">Mensaje para el cliente (opcional)</label>
                <textarea name="Cambios.MensajePublico" id="Cambios_MensajePublico" class="campo campo-completo" rows="3" maxlength="4000"
                          placeholder="Ej. explicación de la resolución">@Model.Cambios.MensajePublico</textarea>
                <p class="ayuda">Cambiar prioridad, categoría o agente no se notifica al cliente. El estado y el mensaje sí.</p>
                <button type="submit" class="boton-primario boton-bloque">Guardar cambios</button>
            </form>
        }
    </aside>
</div>
}

@if (Model.EsEquipo)
{
<dialog id="modal-plantillas" class="dialogo dialogo-ancho" aria-labelledby="modal-plantillas-titulo">
    <header class="modal-encabezado">
        <h2 id="modal-plantillas-titulo">Plantillas de respuesta</h2>
        <button type="button" class="modal-cerrar" id="modal-plantillas-cerrar" aria-label="Cerrar">✕</button>
    </header>

    @if (!Model.Plantillas.Any())
    {
        <p class="texto-secundario" style="margin:0 0 16px">Todavía no hay plantillas. Creá la primera.</p>
    }
    else
    {
        <table class="tabla" style="margin-bottom:20px">
            <thead>
                <tr><th>Título</th><th>Visibilidad</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Plantillas)
                {
                    <tr>
                        <td><strong>@p.Titulo</strong><br/><span class="texto-secundario" style="font-size:12px">@(p.Texto.Length > 60 ? p.Texto[..60] + "…" : p.Texto)</span></td>
                        <td>
                            @if (p.Compartida) { <span class="pill pill-info">Todos</span> }
                            else               { <span class="pill">Solo yo</span> }
                        </td>
                        <td style="white-space:nowrap">
                            @if (Model.EsAdministrador || p.CreadoPorId == Model.UsuarioId)
                            {
                                <button type="button" class="boton-secundario boton-xs btn-editar-plantilla"
                                        data-id="@p.Id" data-titulo="@p.Titulo"
                                        data-texto="@p.Texto" data-compartida="@p.Compartida.ToString().ToLower()">Editar</button>
                            }
                            <form method="post" asp-page-handler="EliminarPlantilla" asp-route-id="@Model.Id" style="display:inline"
                                  onsubmit="return confirm('¿Desactivar «@p.Titulo»?')">
                                <input type="hidden" name="plantillaId" value="@p.Id" />
                                <button type="submit" class="boton-peligro boton-xs">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- Nueva plantilla -->
    <div id="panel-nueva" style="border-top:1px solid var(--color-borde);padding-top:16px">
        <h3 style="margin:0 0 12px;font-size:14px;font-weight:600">Nueva plantilla</h3>
        <form method="post" asp-page-handler="CrearPlantilla" asp-route-id="@Model.Id">
            <div class="grupo-campo">
                <label class="etiqueta">Título</label>
                <input type="text" name="NuevaPlantilla.Titulo" class="campo campo-completo" maxlength="100" required placeholder="Ej. Cierre por inactividad" />
            </div>
            <div class="grupo-campo">
                <label class="etiqueta">Texto</label>
                <textarea name="NuevaPlantilla.Texto" class="campo campo-completo" rows="3" maxlength="4000" required placeholder="Escribí el mensaje completo…"></textarea>
            </div>
            <div class="grupo-campo grupo-campo-inline" style="margin-bottom:12px">
                <input type="checkbox" name="NuevaPlantilla.Compartida" value="true" id="nueva-compartida" />
                <label for="nueva-compartida" class="etiqueta etiqueta-inline">Compartir con todo el equipo</label>
            </div>
            <button type="submit" class="boton-primario">Crear plantilla</button>
        </form>
    </div>

    <!-- Editar plantilla (oculto por defecto) -->
    <div id="panel-editar-plantilla" style="display:none;border-top:1px solid var(--color-borde);padding-top:16px">
        <h3 style="margin:0 0 12px;font-size:14px;font-weight:600">Editar plantilla</h3>
        <form method="post" asp-page-handler="ActualizarPlantilla" asp-route-id="@Model.Id">
            <input type="hidden" name="plantillaId" id="edit-id" />
            <div class="grupo-campo">
                <label class="etiqueta">Título</label>
                <input type="text" id="edit-titulo" name="EditPlantilla.Titulo" class="campo campo-completo" maxlength="100" required />
            </div>
            <div class="grupo-campo">
                <label class="etiqueta">Texto</label>
                <textarea id="edit-texto" name="EditPlantilla.Texto" class="campo campo-completo" rows="3" maxlength="4000" required></textarea>
            </div>
            <div class="grupo-campo grupo-campo-inline" style="margin-bottom:12px">
                <input type="checkbox" id="edit-compartida" name="EditPlantilla.Compartida" value="true" />
                <label for="edit-compartida" class="etiqueta etiqueta-inline">Compartir con todo el equipo</label>
            </div>
            <div style="display:flex;gap:8px">
                <button type="button" class="boton-secundario" id="btn-cancelar-editar">Cancelar</button>
                <button type="submit" class="boton-primario">Guardar</button>
            </div>
        </form>
    </div>
</dialog>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.EsEquipo)
    {
    <script>
    // Selector de plantilla → inserta en textarea
    document.getElementById('selector-plantilla')?.addEventListener('change', function () {
        if (!this.value) return;
        const ta = document.getElementById('Respuesta_Texto');
        if (ta) { ta.value = this.value; ta.focus(); }
        this.value = '';
    });

    // Modal gestión de plantillas
    const modal = document.getElementById('modal-plantillas');
    document.getElementById('btn-gestionar-plantillas')?.addEventListener('click', () => modal.showModal());
    document.getElementById('modal-plantillas-cerrar')?.addEventListener('click', () => modal.close());
    modal?.addEventListener('click', e => { if (e.target === modal) modal.close(); });

    // Editar plantilla
    document.querySelectorAll('.btn-editar-plantilla').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('edit-id').value        = btn.dataset.id;
            document.getElementById('edit-titulo').value    = btn.dataset.titulo;
            document.getElementById('edit-texto').value     = btn.dataset.texto;
            document.getElementById('edit-compartida').checked = btn.dataset.compartida === 'true';
            document.getElementById('panel-nueva').style.display           = 'none';
            document.getElementById('panel-editar-plantilla').style.display = '';
            document.getElementById('edit-titulo').focus();
        });
    });
    document.getElementById('btn-cancelar-editar')?.addEventListener('click', () => {
        document.getElementById('panel-editar-plantilla').style.display = 'none';
        document.getElementById('panel-nueva').style.display           = '';
    });
    </script>
    }
}
