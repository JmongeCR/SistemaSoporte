@page
@model ErrorModel
@{
    Layout = null;
    ViewData["Title"] = Model.Es404 ? "Página no encontrada" : "Error";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Soporte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { margin: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #F4F6F9; font-family: "Inter", system-ui, sans-serif; }
        .error-pagina { text-align: center; padding: 48px 24px; max-width: 480px; }
        .error-codigo { font-size: 96px; font-weight: 700; color: #E5E8ED; line-height: 1; margin: 0 0 16px; }
        .error-titulo { font-size: 24px; font-weight: 700; color: #1A1F29; margin: 0 0 12px; }
        .error-mensaje { color: #737A87; font-size: 15px; line-height: 1.6; margin: 0 0 32px; }
        .error-acciones { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        .boton-primario { display: inline-flex; align-items: center; padding: 10px 20px; background: #296BED; color: #fff; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 600; }
        .boton-primario:hover { background: #1F5AD6; }
        .boton-secundario { display: inline-flex; align-items: center; padding: 10px 20px; border: 1px solid #E5E8ED; background: #fff; color: #1A1F29; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 500; }
        .boton-secundario:hover { background: #F7F7FA; }
    </style>
</head>
<body>
    <div class="error-pagina">
        <p class="error-codigo">@(Model.Es404 ? "404" : "500")</p>
        <h1 class="error-titulo">@(Model.Es404 ? "Página no encontrada" : "Algo salió mal")</h1>
        <p class="error-mensaje">
            @if (Model.Es404)
            {
                <span>La página que buscás no existe o fue movida.</span>
            }
            else
            {
                <span>Ocurrió un error inesperado. Si el problema persiste, contactá al administrador.</span>
            }
        </p>
        <div class="error-acciones">
            <a href="/Dashboard" class="boton-primario">Ir al Dashboard</a>
            <a href="javascript:history.back()" class="boton-secundario">Volver</a>
        </div>
    </div>
</body>
</html>
