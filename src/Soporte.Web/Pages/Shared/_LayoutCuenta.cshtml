<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Soporte</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="cuenta">
        <div class="cuenta-panel-izq" aria-hidden="true">
            <div class="cuenta-panel-marca">
                <svg width="30" height="25" viewBox="0 0 38 32" aria-hidden="true" fill="none">
                    <path d="M7 2h24a5 5 0 0 1 5 5v13a5 5 0 0 1-5 5H15l-8 6v-6a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z" fill="#3b82f6" />
                    <rect x="10" y="9" width="16" height="3" rx="1.5" fill="white" />
                    <rect x="10" y="15.5" width="10" height="3" rx="1.5" fill="white" />
                </svg>
                Soporte
            </div>
            <div class="cuenta-panel-cita">
                <p>"Gestiona cada solicitud con claridad. Resuelve con velocidad."</p>
                <small>Sistema de Soporte Técnico</small>
            </div>
            <div class="cuenta-panel-pie">
                &copy; @DateTime.Now.Year Sistema de Soporte
            </div>
        </div>
        <main class="cuenta-contenido" role="main">
            <div class="cuenta-tarjeta">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
