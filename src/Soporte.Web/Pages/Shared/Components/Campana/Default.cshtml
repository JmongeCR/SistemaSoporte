@model int?
<div class="campana" data-campana
     data-url-resumen="@Url.Page("/Notificaciones/Index", "Resumen")"
     data-url-panel="@Url.Page("/Notificaciones/Index", "Panel")"
     data-intervalo="30">
    <button type="button" class="campana-boton" aria-haspopup="true" aria-expanded="false"
            aria-label="@(Model > 0 ? $"Notificaciones: {Model} sin leer" : "Notificaciones")">
        <span aria-hidden="true">🔔</span>
        <span class="campana-contador" hidden="@(!(Model > 0))">@(Model > 99 ? "99+" : Model?.ToString())</span>
    </button>
    <div class="panel-notificaciones" hidden role="dialog" aria-label="Notificaciones"></div>
</div>
