@page
@model Soporte.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<header class="encabezado-pagina">
    <div>
        @if (Model.EsCliente)
        {
            <h1>Hola, @Model.Nombre.Split(' ')[0]</h1>
            <p>Seguimiento de tus casos de soporte</p>
        }
        else
        {
            <h1>Dashboard</h1>
            <p>@(Model.EsAdministrador ? "Resumen general del equipo" : "Tu ámbito de tickets")</p>
        }
    </div>
    <button type="button" class="boton-primario" data-abrir-modal-crear>
        <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Nuevo ticket
    </button>
</header>

@* ---------------- KPI strip ---------------- *@
@if (Model.EsCliente)
{
    @if (Model.ResumenCliente is { Exito: false })
    {
        <div class="alerta-error" role="alert">No se pudo cargar el resumen. <a asp-page="./Index" class="enlace">Reintentar</a></div>
    }
    else if (Model.ResumenCliente?.Datos is { } resumen)
    {
        <div class="kpi-grid">
            <partial name="_Kpi" model='("Abiertos", resumen.Abiertos, "azul", "Esperando atención")' />
            <partial name="_Kpi" model='("En progreso", resumen.EnProgreso, "ambar", "El equipo trabaja en esto")' />
            <partial name="_Kpi" model='("Esperan tu respuesta", resumen.EsperanTuRespuesta, "rojo", resumen.EsperanTuRespuesta > 0 ? "Revisá tu correo" : "Nada pendiente")' />
            <partial name="_Kpi" model='("Resueltos", resumen.Resueltos, "verde", resumen.Cerrados > 0 ? $"{resumen.Cerrados} cerrados" : null)' />
        </div>
    }
}
else
{
    @if (Model.Metricas is { Exito: false })
    {
        <div class="alerta-error" role="alert">No se pudieron calcular las métricas. <a asp-page="./Index" class="enlace">Reintentar</a></div>
    }
    else if (Model.Metricas?.Datos is { } metricas)
    {
        <div class="kpi-grid">
            <partial name="_Kpi" model='("Abiertos", metricas.Abiertos, "azul", (string?)null)' />
            <partial name="_Kpi" model='("En progreso", metricas.EnProgreso, "ambar", (string?)null)' />
            <partial name="_Kpi" model='("Resueltos hoy", metricas.ResueltosHoy, "verde", (string?)null)' />
            <partial name="_Kpi" model='("SLA vencido", metricas.SlaVencido, "rojo", metricas.SlaVencido > 0 ? "requiere atención" : null)' />
        </div>
    }
}

@* ---------------- Listas de tickets ---------------- *@
<div class="columnas-dashboard @(Model.EsCliente ? "" : "dos-columnas")" style="margin-bottom:16px">
    @if (!Model.EsCliente)
    {
        <div class="tarjeta">
            <div class="dash-seccion">
                <p class="dash-seccion-titulo">Requieren atención</p>
                <a asp-page="/Tickets/Index" class="dash-seccion-link">Ver todos</a>
            </div>
            <partial name="_ListaTicketsDashboard" model='(Model.RequierenAtencion, "Nada urgente por ahora.", false)' />
        </div>
    }
    <div class="tarjeta">
        <div class="dash-seccion">
            <p class="dash-seccion-titulo">@(Model.EsCliente ? "Tus casos recientes" : "Actividad reciente")</p>
            <a asp-page="/Tickets/Index" class="dash-seccion-link">Ver todos</a>
        </div>
        <partial name="_ListaTicketsDashboard" model='(Model.Recientes, Model.EsCliente ? "Todavía no reportaste ningún problema." : "Todavía no hay actividad.", Model.EsCliente)' />
    </div>
</div>

@* ---------------- Gráficas ---------------- *@
@if (!Model.EsCliente && Model.Metricas?.Datos is { } metricasGraf)
{
    <div class="graficas-grid" style="margin-bottom:16px">
        <div class="tarjeta grafica-tarjeta">
            <div class="dash-seccion" style="border-bottom:1px solid var(--color-borde);margin-bottom:16px">
                <p class="dash-seccion-titulo">Estado de tickets</p>
            </div>
            <div class="grafica-contenedor-dona">
                <canvas id="grafica-estados" aria-label="Distribución por estado"></canvas>
            </div>
        </div>
        @if (Model.CargaAgentes is { Exito: true } cargaGraf && cargaGraf.Datos!.Count > 0)
        {
            <div class="tarjeta grafica-tarjeta">
                <div class="dash-seccion" style="border-bottom:1px solid var(--color-borde);margin-bottom:16px">
                    <p class="dash-seccion-titulo">Carga por agente</p>
                </div>
                <div class="grafica-contenedor-barras">
                    <canvas id="grafica-agentes" aria-label="Tickets activos por agente"></canvas>
                </div>
            </div>
        }
    </div>
    <script id="datos-graficas" type="application/json">
    {
        "estados": {
            "abiertos": @metricasGraf.Abiertos,
            "enProgreso": @metricasGraf.EnProgreso,
            "resueltos": @metricasGraf.ResueltosHoy,
            "slaVencido": @metricasGraf.SlaVencido
        },
        "agentes": @(Model.CargaAgentes is { Exito: true } ca ? System.Text.Json.JsonSerializer.Serialize(ca.Datos!.Select(a => new { a.Agente, a.Abiertos, a.EnProgreso })) : "[]")
    }
    </script>
}

@* ---------------- Carga de agentes ---------------- *@
@if (!Model.EsCliente && Model.CargaAgentes is { Exito: true } carga && carga.Datos!.Count > 0)
{
    <div class="tarjeta" style="margin-bottom:16px">
        <div class="dash-seccion">
            <p class="dash-seccion-titulo">Carga por agente</p>
        </div>
        <table class="tabla">
            <thead><tr><th>Agente</th><th>Abiertos</th><th>En progreso</th><th>Resueltos</th><th>Cerrados</th></tr></thead>
            <tbody>
                @foreach (var agente in carga.Datos!)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px">
                                <span class="avatar avatar-sm">@Formato.Iniciales(agente.Agente)</span>
                                <span>@agente.Agente</span>
                            </div>
                        </td>
                        <td>@agente.Abiertos</td>
                        <td>@agente.EnProgreso</td>
                        <td>@agente.Resueltos</td>
                        <td>@agente.Cerrados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
