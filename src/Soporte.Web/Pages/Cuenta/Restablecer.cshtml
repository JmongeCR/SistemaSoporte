@page
@model Soporte.Web.Pages.Cuenta.RestablecerModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<h1>Nueva contraseña</h1>
<p class="cuenta-subtitulo">Elegí una contraseña de al menos 8 caracteres.</p>

@if (Model.MensajeError is not null)
{
    <div class="alerta-error" role="alert">
        @Model.MensajeError
        <div><a asp-page="./Recuperar" class="enlace">Solicitar un nuevo enlace</a></div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Datos.Token))
{
    <form method="post">
        <input type="hidden" asp-for="Datos.Token" />

        <div class="grupo-campo">
            <label asp-for="Datos.NuevaContrasena" class="etiqueta">Nueva contraseña</label>
            <div class="campo-contrasena">
                <input asp-for="Datos.NuevaContrasena" id="nueva" class="campo campo-alto campo-completo" autocomplete="new-password" autofocus />
                <button type="button" class="boton-ver" data-mostrar-contrasena="#nueva" aria-label="Mostrar contraseña" aria-pressed="false"><svg class="icono-ojo icono-ojo-ver" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icono-ojo icono-ojo-ocultar" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg></button>
            </div>
            <span asp-validation-for="Datos.NuevaContrasena"></span>
        </div>

        <div class="grupo-campo">
            <label asp-for="Datos.ConfirmarContrasena" class="etiqueta">Confirmar contraseña</label>
            <input asp-for="Datos.ConfirmarContrasena" class="campo campo-alto campo-completo" autocomplete="new-password" />
            <span asp-validation-for="Datos.ConfirmarContrasena"></span>
        </div>

        <button type="submit" class="boton-primario boton-bloque">Guardar contraseña</button>
    </form>
}

<a asp-page="./Login" class="enlace cuenta-enlace">← Volver a iniciar sesión</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
