@page
@model Soporte.Web.Pages.Cuenta.PerfilModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi perfil";
}

<header class="encabezado-pagina">
    <div class="encabezado-con-avatar">
        <span class="avatar avatar-xl avatar-oscuro">@Formato.Iniciales(Model.NombreActual)</span>
        <div>
            <h1>@Model.NombreActual</h1>
            <p>@Model.CorreoActual · <span class="pill-rol">@Model.RolActual</span></p>
        </div>
    </div>
</header>

@if (Model.MensajeExito is not null)
{
    <div class="alerta-exito" role="status" data-autocerrar>@Model.MensajeExito</div>
}
@if (Model.MensajeError is not null)
{
    <div class="alerta-error" role="alert">@Model.MensajeError</div>
}

<div class="tarjeta formulario">
    <form method="post" data-envio-unico>
        <h2 class="titulo-seccion" style="margin-top:0">Información personal</h2>

        <div class="grupo-campo">
            <label asp-for="Perfil.Nombre" class="etiqueta">Nombre completo <span class="requerido">*</span></label>
            <input asp-for="Perfil.Nombre" class="campo campo-completo" />
            <span asp-validation-for="Perfil.Nombre"></span>
        </div>

        <h2 class="titulo-seccion">Cambiar contraseña</h2>
        <p class="texto-secundario" style="margin:-8px 0 16px;font-size:13px">Dejá los campos en blanco si no querés cambiarla.</p>

        <div class="grupo-campo campo-contrasena">
            <label asp-for="Perfil.ContrasenaActual" class="etiqueta">Contraseña actual</label>
            <input asp-for="Perfil.ContrasenaActual" type="password" class="campo campo-completo" autocomplete="current-password" />
            <button type="button" class="boton-ver" data-mostrar-contrasena="#Perfil_ContrasenaActual" aria-pressed="false" aria-label="Mostrar contraseña"><svg class="icono-ojo icono-ojo-ver" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icono-ojo icono-ojo-ocultar" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg></button>
            <span asp-validation-for="Perfil.ContrasenaActual"></span>
        </div>

        <div class="grupo-campo campo-contrasena">
            <label asp-for="Perfil.NuevaContrasena" class="etiqueta">Nueva contraseña</label>
            <input asp-for="Perfil.NuevaContrasena" type="password" class="campo campo-completo" autocomplete="new-password" />
            <button type="button" class="boton-ver" data-mostrar-contrasena="#Perfil_NuevaContrasena" aria-pressed="false" aria-label="Mostrar contraseña"><svg class="icono-ojo icono-ojo-ver" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg><svg class="icono-ojo icono-ojo-ocultar" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg></button>
            <span asp-validation-for="Perfil.NuevaContrasena"></span>
        </div>

        <div class="acciones-formulario">
            <a asp-page="/Dashboard/Index" class="boton-secundario">Cancelar</a>
            <button type="submit" class="boton-primario">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
