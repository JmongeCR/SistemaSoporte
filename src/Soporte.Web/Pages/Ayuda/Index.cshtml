@page
@model Soporte.Web.Pages.Ayuda.IndexModel
@using Soporte.Abstracciones.Enumeraciones
@using Soporte.Web.Servicios
@inject IUsuarioSesion Sesion
@{
    ViewData["Title"] = "Ayuda";
    Layout = "_LayoutAyuda";
    var puedeCrear = Sesion.EstaAutenticado && Sesion.Rol != RolTipo.Cliente;
    var autenticado = Sesion.EstaAutenticado;
    var secciones = Model.Articulos
        .GroupBy(a => a.CategoriaNombre)
        .OrderBy(g => g.Key)
        .ToList();

    // Icono por nombre de categoría (fallback al ícono genérico)
    string IconoCategoria(string nombre) => nombre.ToLowerInvariant() switch {
        var n when n.Contains("hardware")          => "🖥️",
        var n when n.Contains("red") || n.Contains("conectividad") || n.Contains("wifi") => "🌐",
        var n when n.Contains("cuenta") || n.Contains("acceso") || n.Contains("usuario") => "🔑",
        var n when n.Contains("software") || n.Contains("aplicacion")                    => "⚙️",
        var n when n.Contains("seguridad")                                                => "🔒",
        var n when n.Contains("impresora") || n.Contains("periférico")                   => "🖨️",
        _                                                                                  => "📂"
    };
}

@if (!autenticado)
{
    <!-- ===== VISTA PORTAL PÚBLICO ===== -->
    <section class="kb-hero">
        <div class="kb-hero-inner">
            <h1 class="kb-hero-titulo">¿En qué podemos ayudarte?</h1>
            <p class="kb-hero-subtitulo">Encuentra respuestas a las preguntas más frecuentes</p>
            <div class="kb-hero-busqueda">
                <svg class="kb-busqueda-icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="search" id="kb-buscar" class="kb-input-busqueda"
                       placeholder="Buscar artículos…" autocomplete="off" />
            </div>
        </div>
    </section>

    <div class="kb-portal-contenido">
        @if (!secciones.Any())
        {
            <p class="kb-vacio-portal">No hay artículos disponibles aún.</p>
        }
        else
        {
            <!-- Grid de secciones (cards anchas con lista de artículos dentro) -->
            <div class="kb-secciones-grid" id="kb-secciones">
                @foreach (var seccion in secciones)
                {
                    var arts = seccion.Where(a => a.Publicado).ToList();
                    if (!arts.Any()) continue;
                    <div class="kb-seccion-card" data-seccion="@seccion.Key.ToLowerInvariant()">
                        <div class="kb-seccion-card-header">
                            <span class="kb-seccion-icono" aria-hidden="true">@IconoCategoria(seccion.Key)</span>
                            <div>
                                <h2 class="kb-seccion-card-titulo">@seccion.Key</h2>
                                <span class="kb-seccion-card-count">@arts.Count artículo@(arts.Count == 1 ? "" : "s")</span>
                            </div>
                        </div>
                        <ul class="kb-seccion-lista">
                            @foreach (var art in arts)
                            {
                                <li class="kb-seccion-item" data-titulo="@art.Titulo.ToLowerInvariant()">
                                    <a asp-page="/Ayuda/Articulo" asp-route-slug="@art.Slug" class="kb-seccion-enlace">
                                        <span class="kb-seccion-enlace-titulo">@art.Titulo</span>
                                        <svg class="kb-flecha" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="9 18 15 12 9 6"/>
                                        </svg>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <!-- Estado vacío de búsqueda -->
            <div id="kb-sin-resultados" class="kb-sin-resultados" style="display:none">
                <p>No se encontraron artículos para "<strong id="kb-termino-busqueda"></strong>".</p>
            </div>
        }
    </div>
}
else
{
    <!-- ===== VISTA INTERNA AUTENTICADO ===== -->
    <header class="encabezado-pagina">
        <div>
            <h1>Base de conocimiento</h1>
            <p>Artículos, procedimientos y preguntas frecuentes</p>
        </div>
        @if (puedeCrear)
        {
            <a asp-page="/Ayuda/Nuevo" class="boton-primario">+ Nuevo artículo</a>
        }
    </header>

    @if (!secciones.Any())
    {
        <div class="estado-vacio">
            <p>No hay artículos disponibles.</p>
        </div>
    }
    else
    {
        @foreach (var seccion in secciones)
        {
            <section class="kb-seccion">
                <h2 class="kb-seccion-titulo">@seccion.Key</h2>
                <div class="kb-grid">
                    @foreach (var art in seccion)
                    {
                        <a class="kb-card@(!art.Publicado ? " kb-card-borrador" : "")" asp-page="/Ayuda/Articulo" asp-route-slug="@art.Slug">
                            @if (!art.Publicado)
                            {
                                <span class="pill pill-warn kb-badge-borrador">Borrador</span>
                            }
                            <h3 class="kb-titulo">@art.Titulo</h3>
                            <span class="kb-vistas">@art.Vistas vista@(art.Vistas == 1 ? "" : "s")</span>
                        </a>
                    }
                </div>
            </section>
        }
    }
}

@section Scripts {
<script>
(function () {
    var inp = document.getElementById("kb-buscar");
    if (!inp) return;

    inp.addEventListener("input", function () {
        var q = this.value.trim().toLowerCase();
        var termino = document.getElementById("kb-termino-busqueda");
        var sinRes  = document.getElementById("kb-sin-resultados");
        var grid    = document.getElementById("kb-secciones");
        var hayAlgo = false;

        document.querySelectorAll(".kb-seccion-card").forEach(function (card) {
            var items = card.querySelectorAll(".kb-seccion-item");
            var visibles = 0;
            items.forEach(function (item) {
                var titulo = item.dataset.titulo || "";
                var mostrar = !q || titulo.includes(q);
                item.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });
            card.style.display = visibles > 0 ? "" : "none";
            if (visibles > 0) hayAlgo = true;
        });

        if (sinRes) {
            sinRes.style.display = (!hayAlgo && q) ? "" : "none";
            if (termino) termino.textContent = this.value.trim();
        }
        if (grid) grid.style.display = hayAlgo || !q ? "" : "none";
    });
})();
</script>
}
